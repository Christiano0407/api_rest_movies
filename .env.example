# ---- App ---- #
ENVIRONEMNT=local
API_V1_PREFIX=/api/v1

# ------ PostgreSQL (RDB - Users, roles, sessions tmdb & blocklist) ------ #
POSTGRES_USER=cinema_admin
POSTGRES_PASSWORD: str = cinema_db_api_gateway
POSTGRES_DB: str = cinema_db
POSTGRES_HOST: str = postgres
POSTGRES_PORT: int = 5432
# DATABASE_URL se auto-construye a partir de las 5 variables anteriores (ver app/core/config.py).
# Solo defínela aquí si necesitas un connection string totalmente distinto (ej. un RDS externo).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db